<html>
<head>
  <link rel="stylesheet" href="css/contact_styling.css">
  <link rel="stylesheet" href="css/Main_styling.css">
</head>
<body>
    <header>
        <nav class="upper-nav">
            <div class="social-icons">
                <img src="images/facebooklogo.png" alt="Facebook">
                <img src="images/twitterlogo.png" alt="Twitter">
                <img src="images/instagramlogo.png" alt="Instagram">
                <img src="images/linkedinlogo.png" alt="LinkedIn">
                </div>
                <div class="welcome-message">
                <p>Welcome To Harb Telecom</p>
            </div>
        </nav>
    </header>
    <br>
    <div>
    <ul>
        <li><a href="/">Home</li>
        <li class="has-submenu"><a href="about">About</a></li>
        <li><a href="products">Products</a></li>
        <li><a href="contact">Contact Us</a></li>
        <div id="cart-icon"><a href="cart">View Cart</a></div>
    </ul>
    </div>
    <br>
    <div class="contact-container">
        <h2>Contact Us</h2>
        <p>Harb Telecom , Beirut , Lebanon<br>Phone: +9611550484<br>Email:harbtelecom@gmail.com.lb</p>
        <form action="/contact/send-message" method="POST">
            <input type="text" id="name" name="name" placeholder="Your name" required>
            <input type="email" id="email" name="email" placeholder="Your email" required>
            <textarea id="message" name="message" placeholder="Your message" required></textarea>
            <input type="submit" value="Send">
        </form>
    </div>
    <div class="Downbanner">
        <div class="branch-info">
            <p id="bi">Visit our branches:</p>
            <ul>
            <li><a href="#">1st branch:Beirut,Haret Hreik<br>01/550484-81/723602<br><br></a></li>
            <li><a href="#">2nd branch: Nabatiyeh ,toul<br>01/550484-81/723602<br></a></li>
            </ul>
        </div>
        <div class="opening-hours">
            <p>Opening Hours:</p>
            <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
            <p>Saturday: 10:00 AM - 4:00 PM</p>
            <p>Sunday: Closed</p>
        </div>
    </div>
</body>
</html>
