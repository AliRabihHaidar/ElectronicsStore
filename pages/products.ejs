<html>
<head>
    <link rel="stylesheet" href="css/products_styling.css">
    <link rel="stylesheet" href="css/Main_styling.css">
    <title><%= title %></title>
</head>
<body>
    <header>
        <nav class="upper-nav">
            <div class="social-icons">
                <img src="images/facebooklogo.png" alt="Facebook">
                <img src="images/twitterlogo.png" alt="Twitter">
                <img src="images/instagramlogo.png" alt="Instagram">
                <img src="images/linkedinlogo.png" alt="LinkedIn">
            </div>
            <div class="welcome-message">
                <p>Welcome To Harb Telecom</p>
            </div>
        </nav>
    </header>
    <br>
    <div>
        <ul>
            <li><a href="/">Home</li>
            <li class="has-submenu"><a href="about">About</a></li>
            <li><a href="products">Products</a></li>
            <li><a href="contact">Contact Us</a></li>
            <div id="cart-icon"><a href="cart">View Cart</a></div>
        </ul>
    </div>
    <br>

    <input id="search-input" type="text" placeholder="Search...">

    <div class="product-grid">
        <% products.forEach(product => { %>
        <div class="product-item">
            <div class="product-info">
                <img src="images/<%= product.product_name %>.png" alt="<%= product.product_name %>">
                <h3><%= product.product_name %></h3>
                <p>$<%= product.price %></p>
                <p><%= product.description %></p>
                <button class="add-to-cart-btn" onclick="addToCart(<%= product.product_id %>)">Add to Cart</button>
            </div>
        </div>
        <% }); %>
    </div>

    <div class="Downbanner">
        <div class="branch-info">
          <p id="bi">Visit our branches:</p>
          <ul>
            <li><a href="#">1st branch:Beirut,Haret Hreik<br>01/550484-81/723602<br><br></a></li>
            <li><a href="#">2nd branch: Nabatiyeh ,toul<br>01/550484-81/723602<br></a></li>
          </ul>
        </div>
        <div class="opening-hours">
          <p>Opening Hours:</p>
          <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
          <p>Saturday: 10:00 AM - 4:00 PM</p>
          <p>Sunday: Closed</p>
        </div>
    </div>

    <script>
        // filter products by search query
        const searchInput = document.getElementById('search-input');
        const products = document.querySelectorAll('.product-item');
        
        searchInput.addEventListener('input', () => {
            const searchTerm = searchInput.value.toLowerCase();
            products.forEach(product => {
                const productName = product.querySelector('h3').textContent.toLowerCase();
                if (productName.includes(searchTerm)) {
                    product.style.display = 'block';
                } else {
                    product.style.display = 'none';
                }
            });
        });
    </script>
    <script>
        // add to cart button
        function addToCart(product_id) {
            // send post request to add product to the cart
            fetch('/cart/add-to-cart', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({product_id: product_id})
            })
            .then(response => response.json())
            .then(data => {
                console.log(data);
            })
            .catch(error => console.error(error));
        }
    </script>
</body>
</html>
