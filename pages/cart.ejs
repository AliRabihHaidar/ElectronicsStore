<html>
<head>
	<link rel="stylesheet" href="css/main_styling.css">
	<link rel="stylesheet" href="css/products_styling.css">
	<link rel="stylesheet" href="css/cart_styling.css">
</head>
<body>
	<header>
		<nav class="upper-nav">
		<div class="social-icons">
			<img src="images/facebooklogo.png" alt="Facebook">
			<img src="images/twitterlogo.png" alt="Twitter">
			<img src="images/instagramlogo.png" alt="Instagram">
			<img src="images/linkedinlogo.png" alt="LinkedIn">
		</div>
		<div class="logo">
			<img src="images/logo.jpg" alt="logo" >
			</div>
		</nav>
	</header>
  	<br>
	<div>
		<ul>
			<li><a href="/">Home</li>
			<li class="has-submenu"><a href="about">About</a></li>
			<li><a href="products">Products</a></li>
			<li><a href="contact">Contact Us</a></li>
			<a href="cart">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/></svg>
                <div id="cart-size"><%= cartSize %></div>
            </a>
		</ul>
	</div>
	<br>

	<button id="logout">Logout</button>

	<div id="cart-container">
        <h2>Your Shopping Cart</h2>
        <div id="cart-content">
        <% if (products.length > 0) { %>
            <div class="product-grid">
            <% products.forEach(product => { %>
                <div class="product-item">
                    <div class="quantity"><%= product.quantity %></div>
					<img src="images/<%= product.product_name %>.png" onerror="this.style.display='none';">
            		<img src="images/<%= product.product_name %>.jpg" onerror="this.style.display='none';">
                    <div class="product-info">
                        <h3><%= product.product_name %></h3>
                        <p>$<%= product.price %></p>
                        <p><%= product.description %></p>
                        <button class="remove-from-cart-btn" onclick="RemoveFromCart(<%= product.product_id %>)">Remove From Cart</button>
                    </div>
                </div>
            <% }); %>
            </div>
        <% } else { %>
            <p id="empty-cart-message">Your cart is currently empty.</p>
        <% } %>
        </div>
    </div>
	
	<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>
	
	<div class="Downbanner">
    	<div class="branch-info">
			<p id="bi">Visit our branches:</p>
			<ul>
				<li><a href="#">1st branch:Beirut,Haret Hreik<br>01/550484-81/723602<br><br></a></li>
				<li><a href="#">2nd branch: Nabatiyeh ,toul<br>01/550484-81/723602<br></a></li>
			</ul>
		</div>
		<div class="opening-hours">
			<p>Opening Hours:</p>
			<p>Monday - Friday: 9:00 AM - 6:00 PM</p>
			<p>Saturday: 10:00 AM - 4:00 PM</p>
			<p>Sunday: Closed</p>
		</div>
	</div>

	<script src="scripts/common_script.js"></script>
	<script src="scripts/cart_script.js"></script>
</body>
</html>
